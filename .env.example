# --------------------------------------------------------
# Configuración del Bot de Telegram (100% Gratuito)
# 1. Abre Telegram y habla con @BotFather
# 2. Envía /newbot, dale un nombre y copia el Token aquí:
# --------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Canales de Telegram (IDs o @usernames donde el bot es Administrador)
TELEGRAM_CANAL_VIP_ID=@radar_subastas_vip
TELEGRAM_CANAL_FREE_ID=@radar_subastas_publico

# --------------------------------------------------------
# Pasarela de Pagos (Stripe / Telegram Stars)
# --------------------------------------------------------
